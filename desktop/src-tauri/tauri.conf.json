{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Check Widget",
  "version": "0.1.1",
  "identifier": "com.example.homeworktracker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Daily Check",
        "width": 360,
        "height": 580,
        "resizable": false,
        "maximizable": false,
        "minWidth": 320,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "installerHooks": "installer-hooks.nsh",
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
