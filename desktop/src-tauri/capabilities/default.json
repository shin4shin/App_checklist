{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capability for the widget window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default", "core:window:allow-set-position", "core:window:allow-set-size", "core:window:allow-set-resizable", "core:window:allow-available-monitors",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close"
  ]
}

