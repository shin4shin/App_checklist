<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E80D1117">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF161B22"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <View
            android:layout_width="3dp"
            android:layout_height="18dp"
            android:background="#2F81F7"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvSmallTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="데일리 체크"
            android:textColor="#F0F6FC"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSmallPageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8B949E"
            android:textSize="10sp"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/btnSmallPrev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#58A6FF"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/btnSmallNext"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#58A6FF"
            android:textSize="20sp"/>
    </LinearLayout>

    <!-- 행 1~9: 고정 높이 48dp -->
    <LinearLayout android:id="@+id/smallRow1"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/smallCheck1" android:layout_width="24dp"
            android:layout_height="wrap_content" android:gravity="center"
            android:textSize="20sp" android:textColor="#8B949E"/>
        <ImageView android:id="@+id/smallIcon1" android:layout_width="28dp"
            android:layout_height="28dp" android:layout_marginStart="4dp" android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/smallName1" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="20sp" android:textColor="#F0F6FC"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/smallRow2"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/smallCheck2" android:layout_width="24dp"
            android:layout_height="wrap_content" android:gravity="center"
            android:textSize="20sp" android:textColor="#8B949E"/>
        <ImageView android:id="@+id/smallIcon2" android:layout_width="28dp"
            android:layout_height="28dp" android:layout_marginStart="4dp" android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/smallName2" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="20sp" android:textColor="#F0F6FC"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/smallRow3"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/smallCheck3" android:layout_width="24dp"
            android:layout_height="wrap_content" android:gravity="center"
            android:textSize="20sp" android:textColor="#8B949E"/>
        <ImageView android:id="@+id/smallIcon3" android:layout_width="28dp"
            android:layout_height="28dp" android:layout_marginStart="4dp" android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/smallName3" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="20sp" android:textColor="#F0F6FC"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/smallRow4"
        android:layout_width="match_parent" android:layout_height="48dp"
