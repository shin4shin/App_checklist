<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E80D1117">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF161B22"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="3dp"
            android:layout_height="18dp"
            android:background="#2F81F7"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvSmallTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="데일리 체크"
            android:textColor="#F0F6FC"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/widgetEmpty" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="아직 항목이 없습니다" android:textColor="#8B949E" android:visibility="gone" />
    <ListView android:id="@+id/widgetItems" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="vertical" android:divider="@android:color/transparent" android:dividerHeight="0dp" />
</LinearLayout>
