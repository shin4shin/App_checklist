<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="초기화 시간 설정"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 시 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 시 직접 입력 -->
            <EditText
                android:id="@+id/etHour"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="22sp"
                android:gravity="center"
                android:maxLength="2"
                android:hint="00"
                android:background="@null"
                android:padding="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시  "
                android:textSize="16sp"/>

            <!-- 드롭다운 화살표 -->
            <Spinner
                android:id="@+id/spinnerHour"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown"/>
        </LinearLayout>

        <!-- 콜론 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" : "
            android:textSize="22sp"
            android:textStyle="bold"/>

        <!-- 분 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 분 직접 입력 -->
            <EditText
                android:id="@+id/etMinute"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="22sp"
                android:gravity="center"
                android:maxLength="2"
                android:hint="00"
                android:background="@null"
                android:padding="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="분  "
                android:textSize="16sp"/>

            <!-- 드롭다운 화살표 -->
            <Spinner
                android:id="@+id/spinnerMinute"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown"/>
        </LinearLayout>

    </LinearLayout>

    <!-- 요일 선택 (Weekly 전용, 코드에서 visibility 제어) -->
    <LinearLayout
        android:id="@+id/layoutDayPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#30363D"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="초기화 요일"
            android:textSize="14sp"
            android:textColor="#8B949E"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="7">

            <CheckBox
                android:id="@+id/cbSun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="일"
                android:gravity="center"
                android:button="@null"
                android:background="@null"
                android:textSize="13sp"
                android:padding="6dp"/>

            <CheckBox
                android:id="@+id/cbMon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="월"
                android:gravity="center"
                android:button="@null"
                android:background="@null"
                android:textSize="13sp"
                android:padding="6dp"/>

            <CheckBox
                android:id="@+id/cbTue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="화"
                android:gravity="center"
                android:button="@null"
                android:background="@null"
                android:textSize="13sp"
                android:padding="6dp"/>

            <CheckBox
                android:id="@+id/cbWed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="수"
                android:gravity="center"
                android:button="@null"
                android:background="@null"
                android:textSize="13sp"
                android:padding="6dp"/>

            <CheckBox
                android:id="@+id/cbThu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="목"
                android:gravity="center"
                android:button="@null"
                android:background="@null"
                android:textSize="13sp"
                android:padding="6dp"/>

            <CheckBox
                android:id="@+id/cbFri"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="금"
                android:gravity="center"
                android:button="@null"
                android:background="@null"
                android:textSize="13sp"
                android:padding="6dp"/>

            <CheckBox
                android:id="@+id/cbSat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="토"
                android:gravity="center"
                android:button="@null"
                android:background="@null"
                android:textSize="13sp"
                android:padding="6dp"/>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>