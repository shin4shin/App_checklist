<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/lockWidgetRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"  android:background="@drawable/lock_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="8dp">
    <TextView android:id="@+id/lockWidgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="곧 끝나는 일정" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" android:singleLine="true"/>
    <TextView android:id="@+id/lockWidgetProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="데일리 · 위클리" android:textSize="13sp" android:textColor="#D9FFFFFF" android:singleLine="true" android:layout_marginTop="2dp"/>
    <LinearLayout android:id="@+id/lockWidgetFirst" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="4dp">
        <TextView android:id="@+id/lockWidgetFirstTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="24시간 이내 일정 없음" android:textSize="15sp" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/lockWidgetFirstTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="일정을 눌러 확인" android:textSize="13sp" android:textColor="#E6FFFFFF" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/lockWidgetSecond" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="4dp">
        <TextView android:id="@+id/lockWidgetSecondTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="완료하지 않은 일정 표시" android:textSize="15sp" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/lockWidgetSecondTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="종료가 가까운 순서" android:textSize="13sp" android:textColor="#E6FFFFFF" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
</LinearLayout>
