<resources>
    <style name="Base.Theme.HomeworkTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary_dark</item>
        <item name="colorOnPrimary">@color/md_on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/md_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/md_primary_container</item>
        <item name="colorSecondary">#FFB98A</item>
        <item name="colorOnSecondary">@color/md_on_secondary_container</item>
        <item name="colorSecondaryContainer">#5B1D00</item>
        <item name="colorOnSecondaryContainer">#FFDBCC</item>
        <item name="colorError">#FFB4AB</item>
        <item name="android:colorBackground">@color/md_surface_dark</item>
        <item name="colorSurface">@color/md_surface_dark</item>
        <item name="colorOnSurface">@color/md_on_surface_dark</item>
        <item name="colorSurfaceVariant">#3F4948</item>
        <item name="colorOnSurfaceVariant">#BEC9C7</item>
        <item name="colorOutlineVariant">#3F4948</item>
    </style>

    <style name="Theme.HomeworkTracker" parent="Base.Theme.HomeworkTracker" />

    <style name="Widget.App.MenuCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
    </style>
</resources>
